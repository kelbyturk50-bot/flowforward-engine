# ── Database ──────────────────────────────────────────────
# Railway provides this automatically when you add a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Google Places API ────────────────────────────────────
# Get a free key at console.cloud.google.com
# Enable: Places API (New)
# Free tier: $200/month credit (~5,000 searches/day free)
GOOGLE_PLACES_API_KEY=your_key_here

# ── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Bot Settings ─────────────────────────────────────────
# Comma-separated list of target markets (city, state)
TARGET_MARKETS=Salt Lake City UT,Provo UT,Ogden UT,Saratoga Springs UT

# How many results to fetch per search query (max 20 for Places API)
RESULTS_PER_QUERY=20

# Minimum Google rating to include (0 to include all)
MIN_RATING=0

# Run discovery on this cron schedule (default: 6am daily)
DISCOVERY_CRON=0 6 * * *

# ── CRM ──────────────────────────────────────────────────
# Shared secret the CRM frontend sends as x-api-key.
# Generate a long random string of at least 32 characters. The estimate-recovery
# demo stays off when this is missing or shorter, and that warning does not
# include the key. Rotating this key does NOT revoke demo links already issued:
# lookup is by hash, so an old link still returns 200 until it expires or you
# revoke it, and /p/:slug cannot recompute the link until you mint again.
# If this key or a demo link leaked, revoke each affected proposal with
# POST /api/proposals/:id/demo-token/revoke.
CRM_API_KEY=
# Allowed frontend origins (comma-separated). Unset = any origin.
CORS_ORIGINS=https://your-crm.vercel.app,http://localhost:5173
# Timezone for DISCOVERY_CRON
CRON_TZ=America/Denver

# Branded prototype created when a proposal draft is saved.
# Off unless set to the exact string true. A flags registry (#63) is not
# in this tree yet; until it is, the server reads this variable only.
# FF_PROTOTYPE_ON_DRAFT=true

# ── Pilot #1: unsold-estimate recovery ───────────────────
# Every flag is OFF unless set to the exact string true. Leave these unset.
# FF_PILOT_ESTIMATE_RECOVERY=true
# FF_PILOT_LINK_ON_ONEPAGER=true
# FF_PILOT_ESTIMATE_SMS=true
# Global live-send kill for the paid pilot. Unset means sends stay killed.
# CSV intake does not send. The only value that lifts this gate is true.
# Per-customer live_send_enabled also defaults false. No route sets it true.
# FF_PILOT_ESTIMATE_LIVE_SEND=true
# Public demo rate limit per IP (defaults 60 requests / 60000 ms).
# The IP is the right-most X-Forwarded-For hop. trust proxy is 1 because
# Railway is one reverse proxy; a spoofed left-most address is not the key.
# PILOT_DEMO_RATE_MAX=60
# PILOT_DEMO_RATE_WINDOW_MS=60000
# Demo token lifetime in hours (default 336).
# The token is HMAC-SHA256, keyed by HKDF of CRM_API_KEY (info ff-pilot-demo).
# CRM_API_KEY must be at least 32 characters or the demo stays off.
# Only the hash and generation are stored. /p/:slug recomputes the link and
# does not insert a row. Rotating CRM_API_KEY does not revoke links already
# issued (lookup is by hash). After a rotation the page cannot recompute the
# link until POST /api/proposals/:id/demo-token. A leaked key or leaked link
# also needs POST /api/proposals/:id/demo-token/revoke.
# Revoke sets proposals.demo_revoked_at and that page does not derive a token.
# PILOT_DEMO_TOKEN_TTL_HOURS=336
# Optional absolute origin for the one-pager "Try a live demo" link.
# Unset means a relative /demo/estimate-recovery/:token path.
# PILOT_DEMO_BASE_URL=
# Cities scored as "in your drive-to market" (optional override)
# FIT_HOME_CITIES=Saratoga Springs,Lehi,Provo,Orem,American Fork

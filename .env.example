# ── Database ──────────────────────────────────────────────
# Railway provides this automatically when you add a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Google Places API ────────────────────────────────────
# Get a free key at console.cloud.google.com
# Enable: Places API (New)
# Free tier: $200/month credit (~5,000 searches/day free)
GOOGLE_PLACES_API_KEY=your_key_here

# ── Server ───────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Bot Settings ─────────────────────────────────────────
# Comma-separated list of target markets (city, state)
TARGET_MARKETS=Salt Lake City UT,Provo UT,Ogden UT,Saratoga Springs UT

# How many results to fetch per search query (max 20 for Places API)
RESULTS_PER_QUERY=20

# Minimum Google rating to include (0 to include all)
MIN_RATING=0

# Run discovery on this cron schedule (default: 6am daily)
DISCOVERY_CRON=0 6 * * *
